# ========================================================
# SDHY 项目环境配置文件模板
# 使用方式：复制本文件并重命名为 .env，然后填入真实的密钥和配置
# cp .env.example .env
# ========================================================

# ----------------- 默认大模型 (LLM) 配置 -----------------
DEFAULT_LLM_API_KEY=your_llm_api_key_here
DEFAULT_LLM_BASE_URL=https://ai.ctaigw.cn/v1
DEFAULT_LLM_MODEL_NAME=qwen3-max

# ----------------- 图像生成模型配置 -----------------
IMAGE_MODEL=qwen-image-2.0-pro
IMAGE_MODEL_BASE_URL=https://ai.ctaigw.cn/v1/services/aigc/multimodal-generation/generation

# ----------------- 视频生成模型配置 -----------------
VIDEO_MODEL=cdance2.0-fast-0611
VIDEO_API_KEY=your_video_api_key_here
VIDEO_API_URL=https://ai.ctaigw.cn/v1/contents/generations/tasks

# ----------------- 安全与注册授权秘钥配置 -----------------
# JWT 签名秘钥（建议生产环境使用高强度随机字符串）
JWT_SECRET=your_jwt_secret_key_here

# 管理控制台注册秘钥（用于注册管理员账号）
ADMIN_SECRET_KEY=your_admin_register_secret_key

# 知识管理平台注册秘钥（用于注册知识库维护人员账号）
KNOWLEDGE_SECRET_KEY=your_knowledge_register_secret_key
